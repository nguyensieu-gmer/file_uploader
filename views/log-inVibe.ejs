<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Log in | FileVault</title>

    <link rel="stylesheet" href="/styles.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
  </head>

  <body>
    <main class="login-container">
      <!-- Left decoration -->
      <section class="login-decoration">
        <a href="/" class="logo">
          <i class="fa-solid fa-cloud"></i>
          <span>FileVault</span>
        </a>

        <div class="decoration-content">
          <div class="decoration-icon">
            <i class="fa-solid fa-lock"></i>
          </div>

          <h1>Welcome<br />back!</h1>

          <p>
            Your files are waiting for you. Sign in and continue organizing your
            personal storage.
          </p>
        </div>

        <div class="decoration-footer">
          <i class="fa-solid fa-shield-halved"></i>
          <span>Your personal space, always protected.</span>
        </div>
      </section>

      <!-- Login form -->
      <section class="login-form-section">
        <div class="login-card">
          <div class="login-heading">
            <p class="eyebrow">WELCOME BACK</p>
            <h2>Log in to your account</h2>
            <p>Enter your credentials to access your files.</p>
          </div>

          <!-- Login failure message -->
          <%- include('partials/log-in-failureVibe') %>

          <form action="/log-in" method="post">
            <div class="form-group">
              <label for="name">User name <span>*</span></label>

              <div class="input-wrapper">
                <i class="fa-solid fa-user"></i>

                <input
                  type="text"
                  name="username"
                  id="name"
                  placeholder="Enter your username"
                  autocomplete="username"
                  required
                />
              </div>
            </div>

            <div class="form-group">
              <label for="password">Password <span>*</span></label>

              <div class="input-wrapper">
                <i class="fa-solid fa-lock"></i>

                <input
                  type="password"
                  name="password"
                  id="password"
                  placeholder="Enter your password"
                  autocomplete="current-password"
                  required
                />
              </div>
            </div>

            <button type="submit" class="submit-btn">
              Log in
              <i class="fa-solid fa-arrow-right"></i>
            </button>
          </form>

          <div class="login-footer">
            <p>
              Don't have an account?
              <a href="/sign-up">Sign up</a>
            </p>
          </div>

          <a href="/" class="back-home">
            <i class="fa-solid fa-arrow-left"></i>
            Back to home
          </a>
        </div>
      </section>
    </main>
  </body>
</html>
