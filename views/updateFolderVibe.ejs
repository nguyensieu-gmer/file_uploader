<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Update Folder | FileVault</title>

    <link rel="stylesheet" href="/styles.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
  </head>

  <body>
    <main class="folder-edit-container">
      <div class="folder-edit-card">
        <!-- Header -->
        <div class="folder-edit-header">
          <a href="/" class="back-link">
            <i class="fa-solid fa-arrow-left"></i>
            Back to home
          </a>

          <div class="folder-edit-icon">
            <i class="fa-solid fa-folder-open"></i>
          </div>

          <p class="eyebrow">FOLDER MANAGEMENT</p>

          <h1>Update folder</h1>

          <p class="folder-edit-description">
            Give your folder a new name to keep everything organized.
          </p>
        </div>

        <!-- Form -->
        <div class="folder-edit-body">
          <%- include('partials/errors') %>

          <form action="/folder/update/<%= locals.documentId %>" method="post">
            <div class="form-group">
              <label for="name"> Folder's name <span>*</span> </label>

              <div class="input-wrapper">
                <i class="fa-solid fa-folder"></i>

                <input
                  type="text"
                  name="foldername"
                  id="name"
                  placeholder="Enter a new folder name"
                  required
                  autofocus
                />
              </div>
            </div>

            <button type="submit" class="submit-btn">
              Update folder
              <i class="fa-solid fa-arrow-right"></i>
            </button>
          </form>

          <a href="/" class="cancel-link"> Cancel </a>
        </div>
      </div>

      <p class="folder-edit-footer">
        <i class="fa-solid fa-shield-halved"></i>
        Your files are safe with FileVault.
      </p>
    </main>
  </body>
</html>
