<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <% if (user){%>
      <p>hello <%= user.name%></p>
      <a href="log-out">log out</a>
    <%} else {%>
      <a href="/sign-up">sign up</a>
      <a href="/log-in">log in</a>
    <%}%>
    <h1>Home page</h1>
    <a href="/folder">Add a folder</a>
     <%if (locals.userFolders){%>
      <ul>
        <% locals.userFolders.forEach(folder => {%>
          <li>
            <span><%= folder.name%></span>     
            <a href="folder/view/<%= folder.id%>">view files</a>
            <a href="folder/update/<%= folder.id%>">update</a>
            <form action="folder/delete/<%= folder.id%>" method="post"><button type="submit">delete</button></form>
          </li>
        <%})%>   
      </ul>
    <%}%>
  </body>
</html>
