// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @id @default(autoincrement())
  name String
  email String
  password String
  folders Folder[]
}

model Document {
  id Int @id @default(autoincrement())

  user Folder @relation(fields: [folderId], references: [id])
  folderId Int

  createAt DateTime @default(now())
  size Int?
  originalname String
  path String
  filename String

  doc_link String?
  resource_type String?
  public_id String?
  asset_id String?
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String   @db.Text
  expiresAt DateTime
}

model Folder {
  id Int @id @default(autoincrement())
  name String
  user User @relation(fields: [userId], references: [id])
  userId Int
  documents Document[]
}